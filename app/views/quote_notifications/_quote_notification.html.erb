<%= turbo_frame_tag(dom_id quote_notification) do %>
  <div><%= image_tag quote_notification.account.icon_url_or_default, style: 'display: inline; padding: 2px; max-width: 50px; max-height: 50px;' %><b><%= link_to quote_notification.account.name, quote_notification.account, data: {'turbo-frame': '_top'} %></b> quoted you in <%= link_to quote_notification.status.id, quote_notification.status, data: {'turbo-frame': '_top' } %> <%= time_ago_in_words(quote_notification.created_at) %> ago</div>
<% end %>
